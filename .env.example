# Frontend
VITE_API_BASE_URL=http://localhost:8000
# Set to true to make the SPA require login before showing app pages
VITE_AUTH_REQUIRED=false

# Backend
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sem5_bi
SECRET_KEY=change_this_in_local_dev
